{
  "name": "chopin-ai-monorepo",
  "description": "A self-improving coding agent with a harness-agnostic RSI core",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodePrometheus/chopin-ai.git"
  },
  "license": "Apache-2.0",
  "private": true,
  "packageManager": "pnpm@12.4.1",
  "type": "module",
  "engines": {
    "node": ">=26.1.0"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "protocol:fixtures": "node scripts/protocol-contracts.mjs --check && node packages/harness-pi/tests/fixtures/protocol-deltas.mjs --check",
    "protocol:test": "pnpm build && pnpm protocol:fixtures && cargo test --locked -p chopin-protocol"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
