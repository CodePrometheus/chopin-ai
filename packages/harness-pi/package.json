{
  "name": "@chopin-ai/harness-pi",
  "version": "0.2.0",
  "description": "Durable harness adapter: agent service, client protocol and ACP bridge",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodePrometheus/chopin-ai.git",
    "directory": "packages/harness-pi"
  },
  "type": "module",
  "engines": {
    "node": ">=24.8.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "default": "./dist/acp.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "image": "node scripts/build-image.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^1.9.0",
    "@chopin-ai/core": "workspace:^",
    "@chopin-ai/workspace": "workspace:^",
    "@earendil-works/chord": "1.3.0",
    "@earendil-works/pi-ai": "1.3.0",
    "@earendil-works/pi-durable": "1.3.0",
    "@earendil-works/pi-env": "1.3.0",
    "@earendil-works/pi-mcp": "1.3.0",
    "jose": "^6.2.12",
    "typebox": "1.3.27",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2"
  }
}
