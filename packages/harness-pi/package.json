{
  "name": "@chopin-ai/harness-pi",
  "version": "0.7.0-rc1",
  "description": "Durable harness adapter: agent service, client protocol and ACP bridge",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CodePrometheus/chopin-ai.git",
    "directory": "packages/harness-pi"
  },
  "type": "module",
  "engines": {
    "node": ">=26.1.0"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./protocol": {
      "types": "./dist/protocol.d.ts",
      "default": "./dist/protocol.js"
    },
    "./keys": {
      "types": "./dist/keys.d.ts",
      "default": "./dist/keys.js"
    },
    "./acp": {
      "types": "./dist/acp.d.ts",
      "default": "./dist/acp.js"
    }
  },
  "files": [
    "dist",
    "goals.md"
  ],
  "scripts": {
    "image": "node scripts/build-image.mjs"
  },
  "dependencies": {
    "@agentclientprotocol/sdk": "^2.7.0",
    "@chopin-ai/core": "workspace:*",
    "@chopin-ai/workspace": "workspace:*",
    "@earendil-works/chord": "1.5.2",
    "@earendil-works/pi-ai": "1.5.2",
    "@earendil-works/pi-durable": "1.5.2",
    "@earendil-works/pi-env": "1.5.2",
    "@earendil-works/pi-mcp": "1.5.2",
    "@earendil-works/pi-schema": "1.5.2",
    "jose": "^6.2.17",
    "typebox": "1.4.7",
    "ws": "^8.23.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.2",
    "esbuild": "^0.28.2"
  }
}
